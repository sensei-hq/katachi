+// What a request names → ids (design/14 §4). The chat, the buttons and recipes all resolve through here.
+import { layersOf } from '../craft';
+import type { CraftDoc, Id } from '../craft/types';
+import type { Ref, Scope } from './types';
+
+const words = (s: string) => s.toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length > 2 && !['the', 'and', 'layer', 'layers', 'cut', 'left', 'right'].includes(w));
+
+/** parts (or items, for item actions) a list of refs names, back to front; `selected` is the screen's selection */
+export function resolve(doc: CraftDoc, refs: Ref[], scope: Scope, selected: Id[] = []): Id[] {
+  const layers = layersOf(doc), out: Id[] = [];
+  const add = (ids: Id[]) => { for (const id of ids) if (!out.includes(id)) out.push(id); };
+  const asScope = (partIds: Id[]) => (scope === 'part' ? partIds : [...new Set(partIds.map((pid) => layers.find((l) => l.part.id === pid)!.item.id))]);
+  for (const r of refs) {
+    if ('all' in r) add(scope === 'part' ? layers.map((l) => l.part.id) : doc.items.map((i) => i.id));
+    else if ('selected' in r) add(scope === 'part' ? selected.filter((id) => layers.some((l) => l.part.id === id)) : asScope(selected.filter((id) => layers.some((l) => l.part.id === id))).concat(selected.filter((id) => doc.items.some((i) => i.id === id))));
+    else if ('id' in r) add(doc.items.some((i) => i.id === r.id) ? (scope === 'item' ? [r.id] : doc.items.find((i) => i.id === r.id)!.parts.map((p) => p.id)) : asScope([r.id]));
+    else if ('n' in r) { const l = layers[r.n - 1]; if (l) add(asScope([l.part.id])); }
+    else if ('item' in r) { const t = r.item.toLowerCase(); const it = doc.items.filter((i) => i.name.toLowerCase() === t); const hit = it.length ? it : doc.items.filter((i) => words(i.name).length && words(i.name).every((w) => t.includes(w))); add(scope === 'item' ? hit.map((i) => i.id) : hit.flatMap((i) => i.parts.map((p) => p.id))); }
+    else if ('name' in r) {
+      const t = r.name.toLowerCase();
+      // a whole name said wins over shared words ("the swirl drop left"); shared words only when nothing matches whole
+      const whole = layers.filter((l) => t.includes(l.part.name.toLowerCase()) || t.includes(l.item.name.toLowerCase()));
+      const some = whole.length ? whole : layers.filter((l) => words(l.part.name).length && words(l.part.name).every((w) => t.includes(w)));
+      add(asScope(some.map((l) => l.part.id)));
+    }
+    else if ('role' in r) add(asScope(layers.filter((l) => l.part.ops.some((o) => o.kind === r.role)).map((l) => l.part.id)));
+    else if ('empty' in r) add(asScope(layers.filter((l) => Math.round(l.part.measured?.visiblePct ?? 1) <= 0).map((l) => l.part.id)));
+  }
+  return out;
+}
