+// Every action, registered once (design/14). Task T3's geometry actions join this list as they land.
+import { register } from '../registry';
+import { structureActions } from './structure';
+
+let done = false;
+export function registerAll() { if (done) return; done = true; for (const a of structureActions) register(a as never); }
