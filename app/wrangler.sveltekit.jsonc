{
  "name": "katachi",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "katachi",
      "database_id": "a4a24836-8e75-4d60-b17f-21111ae42df4",
      "migrations_dir": "migrations"
    }
  ]
}
